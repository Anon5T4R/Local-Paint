# PKGBUILD do localraster para Arch (uso pessoal do João; não publicado no AUR).
# Instala a árvore FHS (bin/ + share/) do tarball da release — o mesmo artefato
# que o package.sh gera. O sha256 fica SKIP no repo (o hash só existe após a
# release); o job arch do CI substitui pelo real ao construir o pacote.
#
#   makepkg -si   (local, com o tarball da release ao lado)

pkgname=com.localraster.app
pkgver=0.20.14
pkgrel=1
pkgdesc='Editor de imagem local e open-source, escrito em Rust puro'
arch=(x86_64)
url='https://github.com/Anon5T4R/Local-Raster'
license=('MIT OR Apache-2.0')
provides=('localraster')
# O pacote antigo (Local Paint) se chamava com.localpaint.app e provia localpaint: replaces troca na atualização do sistema.
replaces=('com.localpaint.app' 'localpaint')
conflicts=('localraster' 'com.localpaint.app' 'localpaint')
depends=(glibc gcc-libs libxcb libxrandr libxi libxcursor libxkbcommon)
optdepends=('xdg-desktop-portal: seletor nativo de arquivos (GNOME/KDE já trazem)')
options=(!debug)
source=("localraster-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir"
  install -dm755 "$pkgdir/usr"
  cp -a "localraster-$pkgver-linux-x86_64/bin" "$pkgdir/usr/"
  cp -a "localraster-$pkgver-linux-x86_64/share" "$pkgdir/usr/"
}
