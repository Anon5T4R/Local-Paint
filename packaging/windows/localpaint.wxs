<?xml version="1.0" encoding="utf-8"?>
<!--
  LocalPaint MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build localpaint.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d DisplayVersion=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=...
      -d BannerBmp=... -d DialogBmp=... -d DocsDir=... -d HasCraftFontLicences=... -o out.msi

  Per-machine install into Program Files\LocalPaint, with a Start Menu shortcut and a desktop
  shortcut, an App Paths entry, and LocalPaint's own file types offered under "Open with" (never
  forced as the default). Files opened with LocalPaint arrive on its command line.

  UpgradeCode and the component GUIDs below belong to LocalPaint alone. Never copy them from (or
  into) a sibling app of the suite: Windows Installer treats every package sharing an UpgradeCode
  as one product, so a shared code makes one app's installer refuse to install ("a newer version
  is already installed") or silently uninstall the other.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package
      Name="LocalPaint"
      Manufacturer="Anon5T4R"
      Version="$(var.Version)"
      UpgradeCode="5D654232-F0D3-448A-AA92-6AAA765777B0"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="LocalPaint image editor" Manufacturer="Anon5T4R" />
    <!-- HKLM registrations must never point into a per-user installation: allow removing an
         existing installation even if an older MSI let it install per-user. -->
    <Launch Condition="ALLUSERS = 1 OR (Installed AND REMOVE = &quot;ALL&quot;)"
        Message="LocalPaint must be installed for all users. Run setup with administrator privileges and ALLUSERS=1; per-user installation is not supported." />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of LocalPaint is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows Installer caches this icon under its Id's filename, and an icon whose Id carries
         the target's .exe extension is what the shell expects (ICE50 for advertised shortcuts,
         and the taskbar cache) even when the source is an ICO. -->
    <Icon Id="LocalPaintIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LocalPaintIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Anon5T4R/Local-Paint" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Anon5T4R/Local-Paint" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Anon5T4R/Local-Paint/discussions" />

    <!-- The setup wizard: WixUI_Minimal is welcome + licence, progress, then a finish page with
         "Launch LocalPaint" (ticked by default). Its art is ours, drawn from the app icon by
         package.ps1, not WiX's stock bitmaps. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="LocalPaint $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LocalPaint" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- Runs in the wizard's own (elevated) process, so the app starts in the chosen session. -->
    <Property Id="WixShellExecTarget" Value="[#LocalPaintExe]" />
    <CustomAction Id="LaunchLocalPaint" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through localpaint.en-us.wxl. -->
    <Property Id="LocalPaintVersion" Value="$(var.DisplayVersion)" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLocalPaint"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LocalPaint" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="LocalPaint" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="LocalPaintFiles" />
    </Feature>
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="LocalPaintFiles" Directory="INSTALLFOLDER">
      <Component Id="LocalPaintApp" Guid="A6DE41B7-A80F-4C59-A17E-BB68065BF67E">
        <File Id="LocalPaintExe" Source="$(var.BinDir)\localpaint.exe" KeyPath="yes" />

        <!-- .pcraft: LocalPaint's own format; LocalPaint is its default app. -->
        <ProgId Id="LocalPaint.Document" Description="LocalPaint Document" Icon="LocalPaintExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-localpaint">
            <Verb Id="open" Command="Open" TargetFile="LocalPaintExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="LocalPaint.PhotoshopDocument" Description="PSD Document" Icon="LocalPaintExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalPaint.PhotoshopDocument\shell\open\command" Value="&quot;[#LocalPaintExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="LocalPaint.Image" Description="Image" Icon="LocalPaintExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalPaint.Image\shell\open\command" Value="&quot;[#LocalPaintExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psd\OpenWithProgids" Name="LocalPaint.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psb\OpenWithProgids" Name="LocalPaint.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdn\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ora\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.kra\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.krz\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tif\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tiff\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tga\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.qoi\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="LocalPaint.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "localpaint"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe" Name="FriendlyAppName" Value="LocalPaint" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\shell\open\command" Value="&quot;[#LocalPaintExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localpaint.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\localpaint.exe" Value="[#LocalPaintExe]" Type="string" />
        <!-- Where this MSI installed the app. The app's own updater reads it (HKLM here) under the
             suite's key to know this is an MSI install, so it updates with the new MSI rather than
             the portable zip. -->
        <RegistryValue Root="HKLM" Key="Software\Anon5T4R\LocalPaint" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Shortcuts are plain links to localpaint.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows
           can't use as a file handler, and Windows Installer caches their icon under its <Icon Id>.
           Each has its own component with an HKLM key path, so Windows Installer removes it on
           uninstall; in this per-machine package both folders are the all-users ones (a desktop
           shortcut for every account, as the suite's installers do). -->
      <Component Id="LocalPaintStartMenuShortcut" Directory="ProgramMenuFolder" Guid="2F2A89DC-8A53-4C3A-AA93-036DA7E2F80A">
        <Shortcut Id="StartMenuShortcut" Name="LocalPaint" Description="LocalPaint image editor"
            Target="[#LocalPaintExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalPaintIcon.exe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\LocalPaint\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Search alias: Start Menu search matches the shortcut's name, and every suite name
           starts with Local — a plain "photo" finds nothing. Same exe, same icon, own
           component so uninstall removes it. -->
      <Component Id="LocalPaintAliasShortcut" Directory="ProgramMenuFolder" Guid="6671DC8F-A0C8-4982-8EF8-62AFE0E453D1">
        <Shortcut Id="AliasShortcut" Name="Photo" Description="LocalPaint image editor"
            Target="[#LocalPaintExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalPaintIcon.exe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\LocalPaint\Shortcuts" Name="Alias" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="LocalPaintDesktopShortcut" Directory="DesktopFolder" Guid="77CDAC6E-8F92-4C6E-A384-358A8E5A42F5">
        <Shortcut Id="DesktopShortcut" Name="LocalPaint" Description="LocalPaint image editor"
            Target="[#LocalPaintExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalPaintIcon.exe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\LocalPaint\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="LocalPaintCli">
        <File Id="LocalPaintCliExe" Source="$(var.BinDir)\localpaint-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
