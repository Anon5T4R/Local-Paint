<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.localraster.app</id>
  <!-- The app was called Local Paint (com.localpaint.app): software centres swap the old entry for this one. -->
  <replaces>
    <id>com.localpaint.app</id>
  </replaces>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Local Raster</name>
  <summary>Edit photos and layered PSD documents</summary>
  <developer id="com.localraster">
    <name>Anon5T4R</name>
  </developer>
  <description>
    <p>
      Local Raster is an open-source, native image editor with the familiar menus,
      shortcuts, panels and tools professionals expect: layers, masks, adjustment
      layers, layer styles, type and brushes.
    </p>
    <ul>
      <li>Open, edit and save layered PSD and PSB files</li>
      <li>8-bit, 16-bit and 32-bit float documents in RGB, grayscale, CMYK and Lab</li>
      <li>A GPU compositor with multithreaded filters</li>
      <li>Every action is a command, scriptable from a CLI, a JSON control channel and an MCP server</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.localraster.app.desktop</launchable>
  <icon type="stock">com.localraster.app</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Anon5T4R/Local-Raster</url>
  <url type="bugtracker">https://github.com/Anon5T4R/Local-Raster/issues</url>
  <url type="help">https://github.com/Anon5T4R/Local-Raster</url>
  <url type="contact">https://github.com/Anon5T4R/Local-Raster/discussions</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>psd</keyword>
    <keyword>layers</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>Editing The Great Wave off Kanagawa with type layers and adjustment layers</caption>
      <image>https://raw.githubusercontent.com/Anon5T4R/Local-Raster/main/docs/images/localraster-demo.jpg</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9fd0ff</color>
    <color type="primary" scheme_preference="dark">#1f64ba</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>localraster</binary>
    <mediatype>application/x-localraster</mediatype>
    <mediatype>image/x-paintnet</mediatype>
    <mediatype>image/openraster</mediatype>
    <mediatype>application/x-krita</mediatype>
    <mediatype>image/vnd.adobe.photoshop</mediatype>
    <mediatype>image/x-psd</mediatype>
    <mediatype>image/x-psb</mediatype>
    <mediatype>image/png</mediatype>
    <mediatype>image/jpeg</mediatype>
    <mediatype>image/tiff</mediatype>
    <mediatype>image/webp</mediatype>
    <mediatype>image/gif</mediatype>
    <mediatype>image/bmp</mediatype>
    <mediatype>image/x-tga</mediatype>
    <mediatype>image/x-icon</mediatype>
    <mediatype>image/vnd.microsoft.icon</mediatype>
    <mediatype>image/x-portable-anymap</mediatype>
    <mediatype>image/x-portable-bitmap</mediatype>
    <mediatype>image/x-portable-graymap</mediatype>
    <mediatype>image/x-portable-pixmap</mediatype>
    <mediatype>image/x-exr</mediatype>
    <mediatype>image/vnd.radiance</mediatype>
    <mediatype>image/avif</mediatype>
    <mediatype>image/qoi</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
